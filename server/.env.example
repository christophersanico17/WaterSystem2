# Backend configuration for the Barangay Kinamlutan Water System API
# (Express + better-sqlite3 — see server/src/db/database.js)
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Deployment only (see DEPLOY.md) — leave unset for local development.
# DB_PATH=/data/water_system.db   # put the database on the host's persistent volume
# TRUST_PROXY=1                   # behind the host's reverse proxy (real client IPs for rate limiting)
# DISCOVERY_PORT=0                # no LAN in the cloud — turn off ESP broadcast discovery

# Required. Generate a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-this-secret

# Optional — only needed if resident Google Sign-In is enabled.
# See server/SETUP.md for how to create this in Google Cloud Console.
GOOGLE_CLIENT_ID=

# PayMongo (https://dashboard.paymongo.com/developers/api-keys) — powers the
# resident "Pay with GCash" flow. Use the sk_test_.../pk_test_... keys while
# developing; switch to sk_live_.../pk_live_... only once you're ready to
# accept real payments.
PAYMONGO_SECRET_KEY=your_paymongo_secret_key_here
PAYMONGO_PUBLIC_KEY=your_paymongo_public_key_here

# Optional but recommended for production. Set this to the signing secret
# shown when you register a webhook endpoint (Developers → Webhooks) pointing
# at https://<your-public-url>/api/webhooks/paymongo. Without it, payments are
# still confirmed via /gcash/sync (polled by the frontend after checkout),
# just without the extra webhook safety net.
PAYMONGO_WEBHOOK_SECRET=
